<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeBundledAssets>false</IncludeBundledAssets>

    <PackageId>DeepSeek.OCR2.Core</PackageId>
    <Version>0.3.2</Version>
    <Title>DeepSeek OCR2 .NET Wrapper</Title>
    <Authors>ichi</Authors>
    <Company>ichi</Company>
    <Owners>ichi</Owners>
    <Copyright>Copyright (c) ichi</Copyright>
    <Description>.NET client and local-runner wrapper for DeepSeek-OCR-2 (Python backend).</Description>
    <PackageTags>deepseek;ocr;llm;vision;transformers;python;vllm;http;client</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/ichichchch/DeepSeekOCR2.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ichichchch/DeepSeekOCR2.NET</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryBranch Condition="'$(RepositoryBranch)' == '' and '$(GITHUB_REF_NAME)' != ''">$(GITHUB_REF_NAME)</RepositoryBranch>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <PackageReleaseNotes>
- Fix offline wheels auto-detection (avoid --no-index when only placeholder exists)
- Add one-click API (DeepSeekOcr2/DeepSeekOcr2Session)
- Add netstandard2.0 target framework
- Add Windows auto Python+pIP bootstrap (portable python download)
- Add config template as contentFiles with copy-to-output
    </PackageReleaseNotes>

    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Python\**\*.py" />
    <EmbeddedResource Include="Python\**\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="Templates\**\*.json" Pack="true" PackagePath="contentFiles\any\any\DeepSeek.OCR2\templates\" PackageCopyToOutput="true" />
    <None Include="buildTransitive\DeepSeek.OCR2.Core.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Bundled') AND '$(IncludeBundledAssets)' == 'true'">
    <None Include="Bundled\**\*"
          Pack="true"
          PackagePath="contentFiles\any\any\DeepSeek.OCR2\bundled\%(RecursiveDir)%(Filename)%(Extension)"
          PackageCopyToOutput="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
