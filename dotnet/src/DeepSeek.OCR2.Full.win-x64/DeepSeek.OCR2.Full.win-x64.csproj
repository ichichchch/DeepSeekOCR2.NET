<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>DeepSeek.OCR2.Full.win-x64</PackageId>
    <Version>0.3.1</Version>
    <Title>DeepSeek OCR2 Full Offline Distribution (win-x64)</Title>
    <Description>Meta-package that pulls DeepSeek.OCR2 plus bundled python runtime, wheels, and model (win-x64).</Description>
    <PackageTags>deepseek;ocr;offline;full;win-x64</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/ichichchch/DeepSeekOCR2.NET.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSeek.OCR2.Meta\DeepSeek.OCR2.Meta.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\DeepSeek.OCR2\icon.png" Link="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
